# Copy to .env and fill in. Never commit .env (this repo is public).

# Gemini API key (https://aistudio.google.com/apikey). Used by the intent
# node and the explainer, and by image generation when IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=

# Text model for intent (structured output) and the explainer.
GEMINI_MODEL=gemini-3.5-flash-lite

# Image generation: "stub" = placeholder candidates, no key needed (default);
# "gemini" = Gemini image model (needs a billed key),
# "pollinations" = free real images, no key needed.
# Rasters are saved under GENERATED_DIR.
IMAGE_PROVIDER=stub
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_CANDIDATES=3

# Only for IMAGE_PROVIDER=pollinations.
POLLINATIONS_MODEL=flux

# Folder for generated rasters; served at /generated.
GENERATED_DIR=generated

# Explainer: true = use the LLM (falls back to a template without a key).
EXPLAIN_WITH_LLM=true

# Max raster side in pixels before vectorization (keeps SVGs small).
VECTOR_MAX_PX=512
