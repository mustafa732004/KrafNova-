# Copy to .env and fill in. Never commit .env (this repo is public).

# Gemini API key (https://aistudio.google.com/apikey). Used by the intent
# node and the explainer, and by image generation when IMAGE_PROVIDER=gemini.
GEMINI_API_KEY=

# Text model for intent (structured output) and the explainer.
GEMINI_MODEL=gemini-3.5-flash-lite

# Image generation: "stub" = placeholder candidates, no key needed (default);
# "gemini" = Gemini image model (needs a billed key),
# "pollinations" = free real images, no key needed,
# "horde" = AI Horde, free, negative-prompt support (slow public queue),
# "gemini-svg" = Gemini text model writes the SVG directly: free with the
#   same GEMINI_API_KEY, seconds instead of minutes, no raster/tracing step.
# Rasters (and gemini-svg SVGs) are saved under GENERATED_DIR.
IMAGE_PROVIDER=stub
IMAGE_MODEL=gemini-2.5-flash-image
IMAGE_CANDIDATES=3

# Only for IMAGE_PROVIDER=pollinations.
POLLINATIONS_MODEL=flux

# Folder for generated rasters; served at /generated.
GENERATED_DIR=generated

# Explainer: true = use the LLM (falls back to a template without a key).
EXPLAIN_WITH_LLM=true

# Max raster side in pixels before vectorization (keeps SVGs small).
VECTOR_MAX_PX=512

# Vectorizer backend: "vtracer" = smooth curves (default, needs the vtracer
# package, falls back to rects), "rects" = dependency-free blocky tracer.
VECTOR_BACKEND=vtracer
# vtracer speckle filter in px (drops tiny blobs) and fraction of the bottom
# edge cropped before tracing to cut provider watermark strips.
VECTOR_FILTER_SPECKLE=16
VECTOR_WATERMARK_CROP=0.06

# AI Horde (stablehorde.net) provider: free, anonymous key by default.
# IMAGE_PROVIDER=horde
HORDE_API_KEY=0000000000
HORDE_BASE_URL=https://stablehorde.net/api/v2
HORDE_MODEL=SDXL 1.0
# Max seconds to wait for one queued generation.
HORDE_TIMEOUT=600
